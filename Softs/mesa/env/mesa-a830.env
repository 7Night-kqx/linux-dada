# /etc/environment snippet for a system-wide Mesa A830 override.
# Debian/Ubuntu libdir is used; Alpine uses /opt/mesa-a830/lib.
# Only LD_LIBRARY_PATH/runtime matters for programs started from a session;
# the rest make the loader pick our EGL/Vulkan/GBM instead of the distro ones.
LD_LIBRARY_PATH="/opt/mesa-a830/runtime"
LIBGL_DRIVERS_PATH="/opt/mesa-a830/lib/aarch64-linux-gnu/dri"
GBM_BACKENDS_PATH="/opt/mesa-a830/lib/aarch64-linux-gnu/gbm"
__EGL_VENDOR_LIBRARY_FILENAMES="/opt/mesa-a830/share/glvnd/egl_vendor.d/50_mesa.json"
VK_DRIVER_FILES="/opt/mesa-a830/share/vulkan/icd.d/freedreno_icd.aarch64.json"
# Optional: force software GL when debugging the GPU:
#LIBGL_ALWAYS_SOFTWARE=0
